# PORT ist der Port, auf dem der Server lokal läuft.
PORT=3000

# HOST ist die Adresse, auf der der Server lokal lauscht.
# 127.0.0.1 bedeutet: nur auf diesem Computer erreichbar.
HOST="127.0.0.1"

# DATABASE_URL ist die Verbindung zur PostgreSQL-Datenbank.
# PostgreSQL ist eine relationale SQL-Datenbank.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodmeal_api?schema=public"

# ALLOWED_ORIGIN ist die Frontend-Adresse, die per CORS erlaubt wird.
# CORS bedeutet Cross-Origin Resource Sharing. Es schützt Browser-Anfragen zwischen verschiedenen Adressen.
ALLOWED_ORIGIN="http://localhost:5173"
